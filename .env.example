# GAUGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GAUGE_MAX_UPLOAD_MB=300
# GAUGE_MAX_ACTIVE_JOBS=2
# GAUGE_MAX_WAITING_JOBS=12
# GAUGE_JOB_TIMEOUT_S=900
# GAUGE_DAILY_SAM_FRAMES=100000
# GAUGE_JOBS_PER_HOUR=120
# GAUGE_VOICE_PER_HOUR=300
